# Solana RPC Endpoint (Devnet default)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# LLM Provider Configuration ("gemini" [default, free key from Google AI Studio] or "anthropic")
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Default - Free Tier from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Anthropic API Configuration (Optional alternative)
# Never expose keys to the browser!
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-sonnet-5-5
